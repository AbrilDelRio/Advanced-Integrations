<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="MFD" constructor="AdvancedIntegrationConfigurator" version="1.0.17"
            display-name-key="Advanced Integration Configurator"
            description-key="Visual configurator for Advanced Integration mappings, triggers and conditions"
            control-type="standard">
    
    <property name="recordId" display-name-key="Advanced Mapping ID"
              description-key="mfd_advancedmappingid to open directly (optional)"
              of-type="SingleLine.Text" usage="bound" required="false" />

    <resources>
      <code path="index.ts" order="1" />
      <css path="css/AdvancedIntegrationConfig.css" order="1" />
    </resources>

    <feature-usage>
      <uses-feature name="WebAPI" required="true" />
      <uses-feature name="Utility" required="true" />
    </feature-usage>
  </control>
</manifest>
